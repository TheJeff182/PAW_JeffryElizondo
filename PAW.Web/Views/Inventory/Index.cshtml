@model IEnumerable<PAW.Models.DTO.InventoryDTO>
@{
    ViewData["Title"] = "Inventory Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Inventories</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Inventory
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Inventory ID</th>
                            <th>Unit Price</th>
                            <th>Units In Stock</th>
                            <th>Product ID</th>
                            <th>Date Added</th>
                            <th>Last Updated</th>
                            <th>Modified By</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var inventory in Model)
                            {
                                <tr>

                                    <td>
                                        @inventory.InventoryId
                                    </td>

                                    <td>
                                        @inventory.UnitPrice?.ToString("C")
                                    </td>

                                    <td>
                                        @inventory.UnitsInStock
                                    </td>

                                    <td>
                                        @inventory.ProductId
                                    </td>

                                    <td>
                                        @inventory.DateAdded?.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td>
                                        @inventory.LastUpdated?.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td>
                                        @inventory.ModifiedBy
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@inventory.Id"
                                               class="btn btn-sm btn-warning">
                                                <i class="bi bi-pencil"></i>
                                                Edit
                                            </a>

                                            <!-- Delete -->
                                            <a asp-action="Delete"
                                               asp-route-id="@inventory.Id"
                                               class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash"></i>
                                                Delete
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4">
                                    <p class="text-muted">No inventories found.</p>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>
