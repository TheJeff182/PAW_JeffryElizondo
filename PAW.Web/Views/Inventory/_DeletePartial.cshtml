@model PAW.Models.DTO.InventoryDTO

<div class="modal-header">
    <h5 class="modal-title">Delete Inventory</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <p>Are you sure you want to delete this inventory?</p>
    <div class="alert alert-info" role="alert">
        <strong>Inventory ID:</strong> @Model.InventoryId
        <br />
        <strong>Unit Price:</strong> @Model.UnitPrice?.ToString("C")
        <br />
        <strong>Units In Stock:</strong> @Model.UnitsInStock
    </div>
</div>
<div class="modal-footer">
    <form asp-action="DeleteConfirmed" method="post" style="display:inline;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.InventoryId" />
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
</div>
