@model PAW.Models.DTO.NotificationDTO

<div class="modal-header">
    <h5 class="modal-title">Delete Notification</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <p>Are you sure you want to delete this notification?</p>
    <div class="alert alert-info" role="alert">
        <strong>Notification ID:</strong> @Model.NotificationId
        <br />
        <strong>User ID:</strong> @Model.UserId
        <br />
        <strong>Message:</strong> @Model.Message
    </div>
</div>
<div class="modal-footer">
    <form asp-action="DeleteConfirmed" method="post" style="display:inline;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.NotificationId" />
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
</div>
