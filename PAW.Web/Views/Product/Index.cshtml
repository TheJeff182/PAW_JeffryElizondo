@model IEnumerable<PAW.Models.DTO.ProductDTO>
@{
    ViewData["Title"] = "Products";
    var currentPage = (int)ViewBag.CurrentPage;
    var totalPages = (int)ViewBag.TotalPages;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Products</h2>
        <a asp-action="Create" class="btn btn-primary">+ Add Product</a>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Rating</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var product in Model)
                        {
                            <tr>
                                <td>@product.ProductId</td>
                                <td>@product.Name</td>
                                <td>@(string.IsNullOrEmpty(product.Description) ? "-" : (product.Description.Length > 40 ? product.Description.Substring(0, 40) + "..." : product.Description))</td>
                                <td>@product.Rating</td>
                                <td>
                                    <button class="btn btn-sm btn-info" onclick="loadDetailsModal(@product.ProductId)">Details</button>
                                    <a asp-action="Edit" asp-route-id="@product.ProductId" class="btn btn-sm btn-warning">Edit</a>
                                    <button class="btn btn-sm btn-danger" onclick="loadDeleteModal(@product.ProductId)">Delete</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center">No products found.</td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (totalPages > 1)
            {
                <nav class="mt-3">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="1">«</a>
                        </li>
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)">&lt;</a>
                        </li>

                        @{
                            int startPage = Math.Max(1, currentPage - 2);
                            int endPage = Math.Min(totalPages, currentPage + 2);

                            if (startPage > 1)
                            {
                                <li class="page-item"><span class="page-link">...</span></li>
                            }

                            for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                                </li>
                            }

                            if (endPage < totalPages)
                            {
                                <li class="page-item"><span class="page-link">...</span></li>
                            }
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)">&gt;</a>
                        </li>
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@totalPages">»</a>
                        </li>
                    </ul>
                </nav>
                <div class="text-center small text-muted">
                    Page @currentPage of @totalPages | @ViewBag.TotalItems items
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="dynamicModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" id="modalContent"></div>
    </div>
</div>

<script>
function loadDetailsModal(productId) {
    fetch(`/Product/Details/${productId}`)
        .then(response => response.text())
        .then(html => {
            document.getElementById('modalContent').innerHTML = html;
            new bootstrap.Modal(document.getElementById('dynamicModal')).show();
        });
}

function loadDeleteModal(productId) {
    fetch(`/Product/Delete/${productId}`)
        .then(response => response.text())
        .then(html => {
            document.getElementById('modalContent').innerHTML = html;
            new bootstrap.Modal(document.getElementById('dynamicModal')).show();
        });
}
</script>