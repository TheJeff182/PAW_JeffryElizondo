@model PAW.Models.DTO.RoleDTO

<div class="modal-header">
    <h5 class="modal-title">Delete Role</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <p>Are you sure you want to delete this role?</p>
    <div class="alert alert-info" role="alert">
        <strong>Role ID:</strong> @Model.RoleId
        <br />
        <strong>Role Name:</strong> @Model.RoleName
    </div>
</div>
<div class="modal-footer">
    <form asp-action="DeleteConfirmed" method="post" style="display:inline;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.RoleId" />
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
</div>
