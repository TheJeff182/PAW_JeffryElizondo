@{
    Layout = null;
}

<div id="exchangeRateWidget" class="exchange-rate-widget">
    <div class="exchange-rate-header">
        <span class="exchange-rate-title">Tipo de Cambio</span>
        <button id="toggleExchangeRate" class="toggle-btn" aria-label="Toggle exchange rate">
            <i class="bi bi-chevron-down"></i>
        </button>
    </div>
    <div id="exchangeRateContent" class="exchange-rate-content">
        <div class="loading-skeleton">
            <div class="skeleton-line"></div>
            <div class="skeleton-line"></div>
            <div class="skeleton-line"></div>
        </div>
    </div>
</div>
