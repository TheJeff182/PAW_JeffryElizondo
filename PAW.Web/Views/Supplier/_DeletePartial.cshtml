@model PAW.Models.DTO.SupplierDTO

<div class="modal-header">
    <h5 class="modal-title">Delete Supplier</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <p>Are you sure you want to delete this supplier?</p>
    <div class="alert alert-info" role="alert">
        <strong>Supplier ID:</strong> @Model.SupplierId
        <br />
        <strong>Supplier Name:</strong> @Model.SupplierName
        <br />
        <strong>Contact:</strong> @Model.ContactName
    </div>
</div>
<div class="modal-footer">
    <form asp-action="DeleteConfirmed" method="post" style="display:inline;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.SupplierId" />
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
</div>
