@model PAW.Models.DTO.PawTaskDTO

<div class="modal-header">
    <h5 class="modal-title">Delete Task</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <p>Are you sure you want to delete this task?</p>
    <div class="alert alert-info" role="alert">
        <strong>Task ID:</strong> @Model.TaskId
        <br />
        <strong>Task Name:</strong> @Model.Name
        <br />
        <strong>Status:</strong> @Model.Status
    </div>
</div>
<div class="modal-footer">
    <form asp-action="DeleteConfirmed" method="post" style="display:inline;">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.TaskId" />
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
</div>
