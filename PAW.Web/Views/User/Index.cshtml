@model IEnumerable<PAW.Models.DTO.UserDTO>
@{
    ViewData["Title"] = "User Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Users</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add User
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>User ID</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Is Active</th>
                            <th>Role ID</th>
                            <th>Created At</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var user in Model)
                            {
                                <tr>

                                    <td>
                                        @user.UserId
                                    </td>

                                    <td>
                                        @user.Username
                                    </td>

                                    <td>
                                        @user.Email
                                    </td>

                                    <td>
                                        @if (user.IsActive.HasValue)
                                        {
                                            <span class="badge @(user.IsActive.Value ? "bg-success" : "bg-danger")">
                                                @(user.IsActive.Value ? "Active" : "Inactive")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">N/A</span>
                                        }
                                    </td>

                                    <td>
                                        @user.RoleId
                                    </td>

                                    <td>
                                        @user.CreatedAt?.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@user.UserId"
                                               class="btn btn-sm btn-warning">
                                                <i class="bi bi-pencil"></i>
                                                Edit
                                            </a>

                                            <!-- Delete -->
                                            <a asp-action="Delete"
                                               asp-route-id="@user.UserId"
                                               class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash"></i>
                                                Delete
                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    <p class="text-muted">No users found.</p>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>
