@model IEnumerable<PAW.Models.DTO.UserActionDTO>
@{
    ViewData["Title"] = "UserAction Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>User Actions</h2>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>User Action ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var userAction in Model)
                            {
                                <tr>

                                    <td>
                                        @userAction.UserActionId
                                    </td>

                                    <td>
                                        @userAction.Name
                                    </td>

                                    <td>
                                        @userAction.Description
                                    </td>

                                    <td class="text-center">
                                        <small class="text-muted">Read-only</small>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4">
                                    <p class="text-muted">No user actions found.</p>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>
