@model IEnumerable<PAW.Models.DTO.UserRoleDTO>
@{
    ViewData["Title"] = "UserRole Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>User Roles</h2>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>User Role ID</th>
                            <th>Role ID</th>
                            <th>User ID</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var userRole in Model)
                            {
                                <tr>

                                    <td>
                                        @userRole.UserRoleId
                                    </td>

                                    <td>
                                        @userRole.RoleId
                                    </td>

                                    <td>
                                        @userRole.UserId
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <!-- Details -->
                                            <button type="button"
                                                    class="btn btn-sm btn-info"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#detailsModal"
                                                    data-details-url="@Url.Action("Details", new { id = userRole.UserRoleId })">
                                                <i class="bi bi-eye"></i>
                                                View
                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4">
                                    <p class="text-muted">No user roles found.</p>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1" role="dialog" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailsModalLabel">User Role Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detailsContent">
                <!-- Details will load here -->
            </div>
        </div>
    </div>
</div>

<!-- Modal Script -->
<script>
    document.getElementById('detailsModal').addEventListener('show.bs.modal', function (e) {
        const button = e.relatedTarget;
        const url = button.getAttribute('data-details-url');
        const content = document.getElementById('detailsContent');

        fetch(url)
            .then(response => response.text())
            .then(html => {
                content.innerHTML = html;
            })
            .catch(error => {
                content.innerHTML = '<p class="text-danger">Error loading details.</p>';
            });
    });
</script>
